# syntax=docker/dockerfile:1
# vim: filetype=dockerfile
# Dockerfile.secure — используется в CI (GitHub Actions)
#
# Targets:
#   --target=final-cpu   → CPU inference only      (CI default, ~15 min)
#   --target=final-amd64 → CPU + CUDA 12/13 + Vulkan
#   --target=final-arm64 → CPU + JetPack 5/6
#   --target=final-rocm  → CPU + ROCm 6

ARG PARALLEL=8

ARG ROCMVERSION=6.3.3
ARG JETPACK5VERSION=r35.4.1
ARG JETPACK6VERSION=r36.4.0
ARG CMAKEVERSION=3.31.2
ARG VULKANVERSION=1.4.321.1

# ── Build base: AlmaLinux 8 amd64 ─────────────────────────────────────────────
FROM --platform=linux/amd64 rocm/dev-almalinux-8:${ROCMVERSION}-complete AS base-amd64
RUN yum install -y yum-utils \
    && yum-config-manager --add-repo \
       https://developer.download.nvidia.com/compute/cuda/repos/rhel8/x86_64/cuda-rhel8.repo \
    && dnf install -y ccache gcc-toolset-11-gcc gcc-toolset-11-gcc-c++ gcc-toolset-11-binutils \
    && dnf install -y wget ninja-build \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && dnf update -y --security \
    && dnf clean all
ENV PATH=/opt/rh/gcc-toolset-11/root/usr/bin:$PATH
ARG VULKANVERSION
RUN wget -q https://sdk.lunarg.com/sdk/download/${VULKANVERSION}/linux/vulkansdk-linux-x86_64-${VULKANVERSION}.tar.xz \
       -O /tmp/vulkansdk.tar.xz \
    && tar xf /tmp/vulkansdk.tar.xz -C /tmp \
    && /tmp/${VULKANVERSION}/vulkansdk -j 8 vulkan-headers \
    && /tmp/${VULKANVERSION}/vulkansdk -j 8 shaderc \
    && cp -r /tmp/${VULKANVERSION}/x86_64/include/* /usr/local/include/ \
    && cp -r /tmp/${VULKANVERSION}/x86_64/lib/*     /usr/local/lib/ \
    && cp -r /tmp/${VULKANVERSION}/x86_64/bin/*     /usr/local/bin/ \
    && rm -rf /tmp/${VULKANVERSION} /tmp/vulkansdk.tar.xz

FROM --platform=linux/arm64 almalinux:8 AS base-arm64
RUN yum install -y yum-utils epel-release \
    && dnf install -y clang ccache \
    && yum-config-manager --add-repo \
       https://developer.download.nvidia.com/compute/cuda/repos/rhel8/sbsa/cuda-rhel8.repo \
    && dnf update -y --security \
    && dnf clean all
ENV CC=clang CXX=clang++

FROM base-${TARGETARCH:-amd64} AS base
ARG CMAKEVERSION
RUN curl -fsSL \
    https://github.com/Kitware/CMake/releases/download/v${CMAKEVERSION}/cmake-${CMAKEVERSION}-linux-$(uname -m).tar.gz \
    | tar xz -C /usr/local --strip-components 1
ENV LDFLAGS=-s

# ── CPU inference library ─────────────────────────────────────────────────
FROM base AS cpu-build
RUN dnf install -y gcc-toolset-11-gcc gcc-toolset-11-gcc-c++ \
    && dnf clean all
ENV PATH=/opt/rh/gcc-toolset-11/root/usr/bin:$PATH
WORKDIR /src
ARG PARALLEL
COPY CMakeLists.txt CMakePresets.json .
COPY ml/backend/ggml/ggml ml/backend/ggml/ggml
RUN --mount=type=cache,target=/root/.ccache \
    cmake --preset 'CPU' -B /src/build \
    && cmake --build /src/build --parallel ${PARALLEL} \
    && cmake --install /src/build --component CPU --prefix /src/dist --strip

# ── CUDA 12 ────────────────────────────────────────────────────────────────
FROM base AS cuda-12
WORKDIR /src
ARG CUDA12VERSION=12.8
RUN dnf install -y cuda-toolkit-${CUDA12VERSION//./-} \
    && dnf clean all
ENV PATH=/usr/local/cuda-12/bin:$PATH
ARG PARALLEL
COPY CMakeLists.txt CMakePresets.json .
COPY ml/backend/ggml/ggml ml/backend/ggml/ggml
RUN --mount=type=cache,target=/root/.ccache \
    cmake --preset 'CUDA 12' -B /src/build \
    && cmake --build /src/build --parallel ${PARALLEL} \
    && cmake --install /src/build --component CUDA --prefix /src/dist --strip

# ── CUDA 13 ────────────────────────────────────────────────────────────────
FROM base AS cuda-13
WORKDIR /src
ARG CUDA13VERSION=13.0
RUN dnf install -y cuda-toolkit-${CUDA13VERSION//./-} \
    && dnf clean all
ENV PATH=/usr/local/cuda-13/bin:$PATH
ARG PARALLEL
COPY CMakeLists.txt CMakePresets.json .
COPY ml/backend/ggml/ggml ml/backend/ggml/ggml
RUN --mount=type=cache,target=/root/.ccache \
    cmake --preset 'CUDA 13' -B /src/build \
    && cmake --build /src/build --parallel ${PARALLEL} \
    && cmake --install /src/build --component CUDA --prefix /src/dist --strip

# ── ROCm 6 ────────────────────────────────────────────────────────────────
FROM base AS rocm-6
WORKDIR /src
ENV PATH=/opt/rocm/hcc/bin:/opt/rocm/hip/bin:/opt/rocm/bin:/opt/rocm/hcc/bin:$PATH
ARG PARALLEL
COPY CMakeLists.txt CMakePresets.json .
COPY ml/backend/ggml/ggml ml/backend/ggml/ggml
RUN --mount=type=cache,target=/root/.ccache \
    cmake --preset 'ROCm 6' -B /src/build \
    && cmake --build /src/build --parallel ${PARALLEL} \
    && cmake --install /src/build --component HIP --prefix /src/dist --strip
RUN bash -c 'rm -f /src/dist/lib/ollama/rocm/rocblas/library/*gfx90[06]*'

# ── Vulkan ─────────────────────────────────────────────────────────────────
FROM base AS vulkan
WORKDIR /src
COPY CMakeLists.txt CMakePresets.json .
COPY ml/backend/ggml/ggml ml/backend/ggml/ggml
ARG PARALLEL
RUN --mount=type=cache,target=/root/.ccache \
    cmake --preset 'Vulkan' -B /src/build \
    && cmake --build /src/build --parallel ${PARALLEL} \
    && cmake --install /src/build --component Vulkan --prefix /src/dist --strip

# ── JetPack 5 (arm64) ─────────────────────────────────────────────────────────
FROM --platform=${BUILDPLATFORM:-linux/arm64} nvcr.io/nvidia/l4t-jetpack:${JETPACK5VERSION} AS jetpack-5
WORKDIR /src
ARG CMAKEVERSION
RUN apt-get update && apt-get install -y curl ccache \
    && apt-get upgrade -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://github.com/Kitware/CMake/releases/download/v${CMAKEVERSION}/cmake-${CMAKEVERSION}-linux-$(uname -m).tar.gz \
       | tar xz -C /usr/local --strip-components 1
COPY CMakeLists.txt CMakePresets.json .
COPY ml/backend/ggml/ggml ml/backend/ggml/ggml
ARG PARALLEL
RUN --mount=type=cache,target=/root/.ccache \
    cmake --preset 'JetPack 5' -B /src/build \
    && cmake --build /src/build --parallel ${PARALLEL} \
    && cmake --install /src/build --component CUDA --prefix /src/dist --strip

# ── JetPack 6 (arm64) ─────────────────────────────────────────────────────────
FROM --platform=${BUILDPLATFORM:-linux/arm64} nvcr.io/nvidia/l4t-jetpack:${JETPACK6VERSION} AS jetpack-6
WORKDIR /src
ARG CMAKEVERSION
RUN apt-get update && apt-get install -y curl ccache \
    && apt-get upgrade -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://github.com/Kitware/CMake/releases/download/v${CMAKEVERSION}/cmake-${CMAKEVERSION}-linux-$(uname -m).tar.gz \
       | tar xz -C /usr/local --strip-components 1
COPY CMakeLists.txt CMakePresets.json .
COPY ml/backend/ggml/ggml ml/backend/ggml/ggml
ARG PARALLEL
RUN --mount=type=cache,target=/root/.ccache \
    cmake --preset 'JetPack 6' -B /src/build \
    && cmake --build /src/build --parallel ${PARALLEL} \
    && cmake --install /src/build --component CUDA --prefix /src/dist --strip

# ── Go binary (CGO, AlmaLinux 8 base) ───────────────────────────────────────
FROM base AS build
WORKDIR /go/src/github.com/ollama/ollama
RUN dnf install -y gcc-toolset-11-gcc-c++ \
    && dnf clean all
ENV PATH=/opt/rh/gcc-toolset-11/root/usr/bin:$PATH
ENV CC=/opt/rh/gcc-toolset-11/root/usr/bin/gcc
ENV CXX=/opt/rh/gcc-toolset-11/root/usr/bin/g++
COPY go.mod go.sum .
RUN curl -fsSL https://golang.org/dl/go$(awk '/^go/ { print $2 }' go.mod).linux-$(case $(uname -m) in x86_64) echo amd64;; aarch64) echo arm64;; esac).tar.gz \
    | tar xz -C /usr/local
ENV PATH=/usr/local/go/bin:$PATH
RUN go mod download
COPY . .
ENV CGO_ENABLED=1
ARG CGO_CFLAGS
ARG CGO_CXXFLAGS
RUN --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -buildmode=pie -ldflags="-w -s" -o /bin/ollama .

# ───────────────────────────────────────────────────────────────────────────
# FINAL TARGETS  (used via --target=<name>)
# ───────────────────────────────────────────────────────────────────────────

# ── final-cpu: CPU only (~15 min, CI default) ───────────────────────────────
FROM ubuntu:24.04 AS final-cpu
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
       ca-certificates libvulkan1 openssl libssl3 \
       libgcc-s1 libstdc++6 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build     /bin/ollama            /usr/bin/ollama
COPY --from=cpu-build /src/dist/lib/ollama   /usr/lib/ollama/
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV LD_LIBRARY_PATH=/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/usr/lib/ollama
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV NVIDIA_VISIBLE_DEVICES=all
ENV OLLAMA_HOST=0.0.0.0:11434
EXPOSE 11434
RUN groupadd -r ollama && useradd -r -g ollama -s /sbin/nologin ollama \
    && mkdir -p /home/ollama \
    && chown -R ollama:ollama /home/ollama /usr/lib/ollama /usr/bin/ollama
USER ollama
ENTRYPOINT ["/usr/bin/ollama"]
CMD ["serve"]

# ── final-amd64: CPU + CUDA 12/13 + Vulkan ───────────────────────────────
FROM ubuntu:24.04 AS final-amd64
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
       ca-certificates libvulkan1 openssl libssl3 \
       libgcc-s1 libstdc++6 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build     /bin/ollama            /usr/bin/ollama
COPY --from=cpu-build /src/dist/lib/ollama   /usr/lib/ollama/
COPY --from=cuda-12   /src/dist/lib/ollama   /usr/lib/ollama/
COPY --from=cuda-13   /src/dist/lib/ollama   /usr/lib/ollama/
COPY --from=vulkan    /src/dist/lib/ollama   /usr/lib/ollama/
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV LD_LIBRARY_PATH=/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/usr/lib/ollama
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV NVIDIA_VISIBLE_DEVICES=all
ENV OLLAMA_HOST=0.0.0.0:11434
EXPOSE 11434
RUN groupadd -r ollama && useradd -r -g ollama -s /sbin/nologin ollama \
    && mkdir -p /home/ollama \
    && chown -R ollama:ollama /home/ollama /usr/lib/ollama /usr/bin/ollama
USER ollama
ENTRYPOINT ["/usr/bin/ollama"]
CMD ["serve"]

# ── final-arm64: CPU + JetPack 5/6 ──────────────────────────────────────────
FROM ubuntu:24.04 AS final-arm64
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
       ca-certificates libvulkan1 openssl libssl3 \
       libgcc-s1 libstdc++6 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build     /bin/ollama            /usr/bin/ollama
COPY --from=cpu-build /src/dist/lib/ollama   /usr/lib/ollama/
COPY --from=jetpack-5 /src/dist/lib/ollama   /usr/lib/ollama/
COPY --from=jetpack-6 /src/dist/lib/ollama   /usr/lib/ollama/
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV LD_LIBRARY_PATH=/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/usr/lib/ollama
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV NVIDIA_VISIBLE_DEVICES=all
ENV OLLAMA_HOST=0.0.0.0:11434
EXPOSE 11434
RUN groupadd -r ollama && useradd -r -g ollama -s /sbin/nologin ollama \
    && mkdir -p /home/ollama \
    && chown -R ollama:ollama /home/ollama /usr/lib/ollama /usr/bin/ollama
USER ollama
ENTRYPOINT ["/usr/bin/ollama"]
CMD ["serve"]

# ── final-rocm: CPU + ROCm 6 ────────────────────────────────────────────────
FROM ubuntu:24.04 AS final-rocm
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
       ca-certificates libvulkan1 openssl libssl3 \
       libgcc-s1 libstdc++6 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build     /bin/ollama            /usr/bin/ollama
COPY --from=cpu-build /src/dist/lib/ollama   /usr/lib/ollama/
COPY --from=rocm-6    /src/dist/lib/ollama   /usr/lib/ollama/
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV LD_LIBRARY_PATH=/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/usr/lib/ollama
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV NVIDIA_VISIBLE_DEVICES=all
ENV OLLAMA_HOST=0.0.0.0:11434
EXPOSE 11434
RUN groupadd -r ollama && useradd -r -g ollama -s /sbin/nologin ollama \
    && mkdir -p /home/ollama \
    && chown -R ollama:ollama /home/ollama /usr/lib/ollama /usr/bin/ollama
USER ollama
ENTRYPOINT ["/usr/bin/ollama"]
CMD ["serve"]
