# syntax=docker/dockerfile:1
# Hardened for production
ARG PARALLEL=8
ARG ROCMVERSION=6.3.3
ARG CMAKEVERSION=3.31.2

FROM --platform=linux/amd64 rocm/dev-almalinux-9:${ROCMVERSION}-complete AS base-amd64
RUN dnf install -y yum-utils \
    && yum-config-manager --add-repo https://developer.download.nvidia.com/compute/cuda/repos/rhel9/x86_64/cuda-rhel9.repo \
    && dnf install -y ccache gcc-toolset-13-gcc gcc-toolset-13-gcc-c++ gcc-toolset-13-binutils wget ninja-build curl \
    && dnf update -y --security \
    && dnf clean all
ENV PATH=/opt/rh/gcc-toolset-13/root/usr/bin:$PATH

FROM --platform=linux/arm64 almalinux:9 AS base-arm64
RUN yum install -y yum-utils epel-release \
    && dnf install -y clang ccache \
    && yum-config-manager --add-repo https://developer.download.nvidia.com/compute/cuda/repos/rhel9/sbsa/cuda-rhel9.repo \
    && dnf update -y --security \
    && dnf clean all
ENV CC=clang CXX=clang++

FROM base-${TARGETARCH:-amd64} AS base
ARG CMAKEVERSION
RUN curl -fsSL https://github.com/Kitware/CMake/releases/download/v${CMAKEVERSION}/cmake-${CMAKEVERSION}-linux-$(uname -m).tar.gz | tar xz -C /usr/local --strip-components 1
ENV LDFLAGS=-s

FROM base AS cpu-build
WORKDIR /src
RUN dnf install -y gcc-toolset-13-gcc gcc-toolset-13-gcc-c++ && dnf clean all
ENV PATH=/opt/rh/gcc-toolset-13/root/usr/bin:$PATH
ARG PARALLEL
COPY CMakeLists.txt CMakePresets.json ./
COPY ml/backend/ggml/ggml ml/backend/ggml/ggml
RUN cmake --preset 'CPU' -B /src/build \
    && cmake --build /src/build --parallel ${PARALLEL} \
    && cmake --install /src/build --component CPU --prefix /src/dist --strip --parallel ${PARALLEL}

FROM base AS build
WORKDIR /go/src/github.com/ollama/ollama
COPY go.mod go.sum ./
RUN GOARCH=$(case $(uname -m) in x86_64) echo amd64;; aarch64) echo arm64;; esac) \
    && GOVERSION=$(awk '/^go /{print $2}' go.mod) \
    && curl -fsSL https://golang.org/dl/go${GOVERSION}.linux-${GOARCH}.tar.gz | tar xz -C /usr/local
ENV PATH=/usr/local/go/bin:$PATH
RUN go mod download
COPY . .
RUN go build -trimpath -buildmode=pie -ldflags="-w -s" -o /bin/ollama .

FROM ubuntu:24.04 AS final
RUN apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends ca-certificates libvulkan1 openssl libssl3 libgcc-s1 libstdc++6 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
COPY --from=build /bin/ollama /usr/bin/ollama
COPY --from=cpu-build /src/dist/lib/ollama /usr/lib/ollama/
ENV OLLAMA_HOST=0.0.0.0:11434
EXPOSE 11434
RUN groupadd -r ollama && useradd -r -g ollama -s /sbin/nologin ollama \
    && mkdir -p /home/ollama && chown -R ollama:ollama /home/ollama /usr/lib/ollama /usr/bin/ollama
USER ollama
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD ["/usr/bin/ollama", "list"]
ENTRYPOINT ["/usr/bin/ollama"]
CMD ["serve"]
