ARG CUDA_IMAGE=nvidia/cuda:12.0.0-devel-ubuntu22.04
ARG RUNTIME_IMAGE=nvidia/cuda:12.0.0-runtime-ubuntu22.04
ARG CMAKEVERSION=3.31.5
ARG PARALLEL=4

# 1. Builder Stage
FROM --platform=linux/amd64 ${CUDA_IMAGE} AS build
ARG CMAKEVERSION
ARG PARALLEL

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        ninja-build \
        pkg-config && \
    rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://github.com/Kitware/CMake/releases/download/v${CMAKEVERSION}/cmake-${CMAKEVERSION}-linux-x86_64.tar.gz \
    | tar xz -C /usr/local --strip-components 1

WORKDIR /workspace/ollama
COPY go.mod go.sum ./
RUN GO_VERSION=$(awk '/^go/ { print $2 }' go.mod) && \
    curl -fsSL https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz \
    | tar xz -C /usr/local
ENV PATH="/usr/local/go/bin:${PATH}"

COPY CMakeLists.txt CMakePresets.json ./
COPY ml/backend/ggml/ggml ml/backend/ggml/ggml
# Remove archs not supported by CUDA 12.0 (like 90a, 120)
RUN sed -i 's/120-real;//g' CMakePresets.json || true
RUN sed -i 's/120;//g' CMakePresets.json || true
RUN sed -i 's/90a-real;//g' CMakePresets.json || true

RUN cmake --preset "CUDA 12" && \
    cmake --build --preset "CUDA 12" --parallel ${PARALLEL} && \
    cmake --install build --component CUDA --strip --parallel ${PARALLEL}

COPY . .
# Setting CGO_ENABLED=1 is critical for ollama to bind with CUDA/GGML.
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build -o /usr/local/bin/ollama .

# 2. Runtime Stage
FROM --platform=linux/amd64 ${RUNTIME_IMAGE} AS runtime
ENV DEBIAN_FRONTEND=noninteractive

# Update base and install necessary runtime libraries.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        libstdc++6 \
        libgcc-s1 \
        curl \
        openssl && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd --system ollama && \
    useradd --system --gid ollama --create-home --home-dir /home/ollama --shell /usr/sbin/nologin ollama

COPY --from=build /usr/local/bin/ollama /usr/local/bin/ollama
COPY --from=build /workspace/ollama/dist/lib/ollama /usr/local/lib/ollama
RUN chown -R ollama:ollama /usr/local/bin/ollama /usr/local/lib/ollama

ENV LD_LIBRARY_PATH=/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/usr/local/lib/ollama
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV NVIDIA_VISIBLE_DEVICES=all
ENV OLLAMA_HOST=0.0.0.0:11434

EXPOSE 11434
USER ollama
ENTRYPOINT ["/usr/local/bin/ollama"]
CMD ["serve"]
