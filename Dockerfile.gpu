# syntax=docker/dockerfile:1
# GPU: CPU + CUDA 12 + Vulkan
ARG PARALLEL=4
ARG CMAKEVERSION=3.31.2
ARG CUDA12VERSION=12.8
ARG VULKANVERSION=1.4.321.1

FROM almalinux:9 AS base
ARG CMAKEVERSION
RUN dnf install -y epel-release \
 && dnf config-manager --set-enabled crb \
 && dnf install -y make ninja-build wget ca-certificates \
                   gcc-toolset-13-gcc gcc-toolset-13-gcc-c++ \
                   gcc-toolset-13-binutils \
 && dnf install -y --allowerasing curl \
 && dnf update -y --security \
 && dnf clean all \
 && curl -fsSL https://github.com/Kitware/CMake/releases/download/v${CMAKEVERSION}/cmake-${CMAKEVERSION}-linux-$(uname -m).tar.gz \
      | tar xz -C /usr/local --strip-components 1
ENV PATH=/opt/rh/gcc-toolset-13/root/usr/bin:/usr/local/bin:/usr/bin:/bin
ENV LD_LIBRARY_PATH=/opt/rh/gcc-toolset-13/root/usr/lib64:/opt/rh/gcc-toolset-13/root/usr/lib
ENV LDFLAGS=-s

FROM base AS cpu-build
WORKDIR /src
ARG PARALLEL
COPY CMakeLists.txt CMakePresets.json ./
COPY ml/backend/ggml/ggml ml/backend/ggml/ggml
RUN --mount=type=cache,target=/root/.ccache \
    cmake --preset CPU -B /src/build \
 && cmake --build /src/build --parallel ${PARALLEL} \
 && cmake --install /src/build --component CPU --prefix /src/dist --strip --parallel ${PARALLEL}

FROM ubuntu:24.04 AS cuda12-build
ARG CMAKEVERSION
ARG CUDA12VERSION
ARG PARALLEL
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates gnupg2 ninja-build make gcc g++ ccache \
 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/3bf863cc.pub \
    | gpg --dearmor -o /usr/share/keyrings/nvidia-cuda.gpg
RUN echo "deb [signed-by=/usr/share/keyrings/nvidia-cuda.gpg] https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/ /" \
    > /etc/apt/sources.list.d/cuda.list
RUN apt-get update \
 && apt-get install -y --no-install-recommends cuda-nvcc-12-8 cuda-cudart-dev-12-8 libcublas-dev-12-8 \
 && apt-get clean && rm -rf /var/lib/apt/lists/*
ENV PATH=/usr/local/cuda-12.8/bin:/usr/local/bin:/usr/bin:/bin
RUN curl -fsSL https://github.com/Kitware/CMake/releases/download/v${CMAKEVERSION}/cmake-${CMAKEVERSION}-linux-$(uname -m).tar.gz \
    | tar xz -C /usr/local --strip-components 1
WORKDIR /src
COPY CMakeLists.txt CMakePresets.json ./
COPY ml/backend/ggml/ggml ml/backend/ggml/ggml
RUN --mount=type=cache,target=/root/.ccache \
    cmake --preset "CUDA 12" -B /src/build \
 && cmake --build /src/build --parallel ${PARALLEL} \
 && cmake --install /src/build --component CUDA --prefix /src/dist --strip --parallel ${PARALLEL}

FROM base AS vulkan-build
ARG VULKANVERSION
ARG PARALLEL
RUN dnf install -y git python3 python3-pip xz && dnf clean all
RUN wget -q "https://sdk.lunarg.com/sdk/download/${VULKANVERSION}/linux/vulkansdk-linux-x86_64-${VULKANVERSION}.tar.xz" -O /tmp/vk.tar.xz \
 && tar xf /tmp/vk.tar.xz -C /tmp \
 && /tmp/${VULKANVERSION}/vulkansdk -j 4 vulkan-headers glslang shaderc spirv-tools spirv-headers \
 && cp -r /tmp/${VULKANVERSION}/x86_64/include/* /usr/local/include/ \
 && cp -r /tmp/${VULKANVERSION}/x86_64/lib/* /usr/local/lib/ \
 && cp -r /tmp/${VULKANVERSION}/x86_64/bin/* /usr/local/bin/ \
 && rm -rf /tmp/vk.tar.xz /tmp/${VULKANVERSION}
RUN /usr/sbin/ldconfig
ENV VULKAN_SDK=/usr/local
ENV PATH=/usr/local/bin:/opt/rh/gcc-toolset-13/root/usr/bin:/usr/bin:/bin
WORKDIR /src
COPY CMakeLists.txt CMakePresets.json ./
COPY ml/backend/ggml/ggml ml/backend/ggml/ggml
RUN --mount=type=cache,target=/root/.ccache \
    cmake --preset Vulkan -B /src/build \
 && cmake --build /src/build --parallel ${PARALLEL} \
 && cmake --install /src/build --component Vulkan --prefix /src/dist --strip

FROM base AS go-build
WORKDIR /go/src/github.com/ollama/ollama
COPY go.mod go.sum ./
RUN GOARCH=$(case $(uname -m) in x86_64) echo amd64;; aarch64) echo arm64;; esac) \
 && GOVERSION=$(awk "/^go /{print \$2}" go.mod) \
 && curl -fsSL https://golang.org/dl/go${GOVERSION}.linux-${GOARCH}.tar.gz | tar xz -C /usr/local
ENV PATH=/usr/local/go/bin:/opt/rh/gcc-toolset-13/root/usr/bin:/usr/local/bin:/usr/bin:/bin
RUN go mod download
COPY . .
ENV CGO_ENABLED=1
RUN --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -buildmode=pie \
      -ldflags="-w -s -X github.com/ollama/ollama/version.Version=0.20.7" \
      -o /bin/ollama .

FROM ubuntu:24.04 AS final
RUN apt-get update \
 && apt-get upgrade -y \
 && apt-get install -y --no-install-recommends ca-certificates libgcc-s1 libstdc++6 libvulkan1 \
 && apt-get clean && rm -rf /var/lib/apt/lists/*
COPY --from=go-build /bin/ollama /usr/bin/ollama
COPY --from=cpu-build /src/dist/lib/ollama /usr/lib/ollama/
COPY --from=cuda12-build /src/dist/lib/ollama /usr/lib/ollama/
COPY --from=vulkan-build /src/dist/lib/ollama /usr/lib/ollama/
ENV LD_LIBRARY_PATH=/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/usr/lib/ollama
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV NVIDIA_VISIBLE_DEVICES=all
ENV OLLAMA_HOST=0.0.0.0:11434
EXPOSE 11434
RUN groupadd -r ollama && useradd -r -g ollama -s /sbin/nologin ollama \
 && mkdir -p /home/ollama/.ollama \
 && chown -R ollama:ollama /home/ollama /usr/lib/ollama /usr/bin/ollama
USER ollama
ENTRYPOINT ["/usr/bin/ollama"]
CMD ["serve"]
